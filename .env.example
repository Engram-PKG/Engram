# ─── App ──────────────────────────────────────────────────────────────────────
# Set to "production" in prod. Controls behaviours like debug logging.
ENVIRONMENT=development

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL. "db" is the docker-compose service name — use that hostname when
# running via docker compose. Change for an external Postgres instance.
POSTGRES_USER=digitaltwin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=digitaltwin
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://digitaltwin:changeme@db:5432/digitaltwin

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used as the Celery broker and result backend. "redis" is the service name.
REDIS_URL=redis://redis:6379/0

# ─── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=8080

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use this placeholder in production.
SECRET_KEY=replace-this-with-a-real-secret-before-deploying

# How long access tokens remain valid (minutes). Default: 1440 (24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=["http://localhost:8080"]

# ─── AI ───────────────────────────────────────────────────────────────────────
# Required for LLM enrichment (Sprint 6), RAG chat (Sprint 10),
# and agentic actions (Sprint 12). Leave blank until those sprints are active.
ANTHROPIC_API_KEY=

# ─── OAuth — Google (Sprints 3 & 4) ──────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Scopes needed: gmail.readonly, calendar.readonly, drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth — Microsoft (future sprint) ────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ─── OAuth — Slack (Sprint 5) ─────────────────────────────────────────────────
# Create at https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── OAuth — Notion (Sprint 5) ────────────────────────────────────────────────
# Create at https://www.notion.so/my-integrations
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
